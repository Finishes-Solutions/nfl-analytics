# Read-only principal (nfl_readonly) — never the ingest login.
SQL_SERVER=yourserver.database.windows.net
SQL_DATABASE=nfl
SQL_USER=nfl_readonly
SQL_PASSWORD=
# SQL_TRUST_CERT=true          # local Docker SQL Server only

PORT=8081
# Auth. In Azure, turn on App Service Authentication (Microsoft provider) and
# list the account(s) allowed in. The server refuses requests that did not come
# through it unless AUTH_DISABLED=true (local development only).
ALLOWED_EMAILS=you@example.com
# AUTH_DISABLED=true

# AI assistant (Ask page) — optional; the page shows setup steps when unset. See docs/14.
# OPENAI_API_KEY=sk-...                         # OpenAI key, or Azure OpenAI key
# OPENAI_MODEL=                                  # model id, or Azure deployment name
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1   # Azure only; default https://api.openai.com/v1
# OPENAI_EMBED_MODEL=text-embedding-3-small      # enables semantic_search; must match the corpus model
# OPENAI_REASONING_EFFORT=                       # optional: low | medium | high (reasoning models only)
# ASSISTANT_DAILY_TOKEN_LIMIT=2000000
# ASSISTANT_MAX_TOOL_ROUNDS=8
