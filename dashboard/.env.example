# Read-only principal (nfl_readonly) — never the ingest login.
SQL_SERVER=yourserver.database.windows.net
SQL_DATABASE=nfl
SQL_USER=nfl_readonly
SQL_PASSWORD=
# SQL_TRUST_CERT=true          # local Docker SQL Server only

PORT=8081
# Auth. In Azure, turn on App Service Authentication (Microsoft provider) and
# list the account(s) allowed in. The server refuses requests that did not come
# through it unless AUTH_DISABLED=true (local development only).
ALLOWED_EMAILS=you@example.com
# AUTH_DISABLED=true
