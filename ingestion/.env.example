# BALLDONTLIE
BDL_API_KEY=your-goat-tier-key
BDL_RATE_LIMIT_PER_MIN=550

# Azure SQL (ingestion principal needs db_datareader + db_datawriter)
SQL_SERVER=yourserver.database.windows.net
SQL_DATABASE=nfl_analytics
SQL_USER=nfl_ingest
SQL_PASSWORD=change-me

# Backfill range
BACKFILL_FROM=2002
BACKFILL_TO=2025

# Azure OpenAI (semantic layer)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=change-me
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
