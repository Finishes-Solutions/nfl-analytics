PORT=8080
PUBLIC_URL=https://app-nfl-mcp.azurewebsites.net

# LOCAL TESTING ONLY — bypasses OAuth. Never set true in Azure.
AUTH_DISABLED=false

# Entra ID (one app registration serves Claude + Copilot; see docs/10)
ENTRA_TENANT_ID=your-tenant-guid
ENTRA_AUDIENCE=api://your-app-client-id
# Optional: comma-separated Entra user object IDs allowed to use the server
ALLOWED_OBJECT_IDS=

# Azure SQL — the READ-ONLY principal, never nfl_ingest
SQL_SERVER=yourserver.database.windows.net
SQL_DATABASE=nfl_analytics
SQL_USER=nfl_readonly
SQL_PASSWORD=change-me

# Azure OpenAI (semantic_search tool; same model as embed.ts)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=change-me
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
